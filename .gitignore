# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.env
/data-bundle/
/build-provenance.json
# MLflow metadata and artifacts are persisted locally, not committed or DVC-tracked.
/storage/mlflow/
# Virtual environments
.venv

# Track notebooks themselves, not Jupyter's autosaved checkpoints.
.ipynb_checkpoints/

# Keep data payloads out of Git, but allow directories and DVC metadata.
/data/**
!/data/**/
!/data/**/*.dvc
!/data/**/.gitignore

# Test and coverage outputs
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Keep the implementation plan versioned; exclude disposable generated reports.
/documents/reports/


#workspace settings
/.vscode
